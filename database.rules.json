{
  "rules": {
    "lists": {
      "$listId": {
        ".read": "auth != null && ($listId === auth.uid || root.child('lists').child($listId).child('members').child(auth.uid).exists())",
        ".write": "auth != null && ($listId === auth.uid || root.child('lists').child($listId).child('members').child(auth.uid).exists())",
        "owner": {
          ".validate": "!data.exists() || newData.val() === data.val()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || $listId === auth.uid) && root.child('users').child($listId).exists()",
            ".validate": "newData.isBoolean()"
          }
        },
        "wishes": {
          "$wishId": {
            ".validate": "newData.hasChildren(['text', 'done', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('done').isBoolean() && newData.child('createdAt').isNumber()"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "wishes": {
      ".read": "auth != null",
      ".write": "auth != null && !newData.exists()"
    }
  }
}
